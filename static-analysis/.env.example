# Copy to static-analysis/.env. Used only by analysis commands and the push gate.
# Generate a user token after changing the initial SonarQube admin password.
SONAR_TOKEN=
SONAR_HOST_URL=http://127.0.0.1:9000
# Required: choose a private DB password before the analysis stack's first boot.
SONAR_DB_PASSWORD=
# Optional analysis stack override.
# SONAR_PORT=9000
