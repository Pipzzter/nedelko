# Copy to .env. Keys stay on the backend and are never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=4173
# Optional: absolute path, or a path relative to the repository root.
# By default, reuse the single existing .local/*.sqlite database; new installs use nedelko.sqlite.
# NEDELKO_DATABASE_PATH=
# Existing Docker installs can keep their persistent volumes using their current project identifier.
# COMPOSE_PROJECT_NAME=
# Optional: pulse.eco documentation describes Basic authentication.
# Public access may work without it, but do not rely on that remaining true.
PULSE_USERNAME=
PULSE_PASSWORD=
